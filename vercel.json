{
  "buildCommand": "pnpm build && cp dist/public/index.html dist/index.html || true",
  "outputDirectory": "dist",
  "framework": "express",
  "installCommand": "pnpm install --frozen-lockfile",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "index.js"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
